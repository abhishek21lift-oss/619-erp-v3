# 619 ERP — root .gitignore
# Per-package ignores live in backend/.gitignore and frontend/.gitignore.
# This file catches anything missed at the repo root.

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# Build artefacts
.next/
out/
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Stale junk mentioned in README — never commit it back if it reappears
_DELETE_ME_*/
